NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Media storage — Backblaze B2 via its S3-compatible API. Named S3_* because
# Netlify reserves AWS_*, and because the protocol really is S3.
# Region and endpoint must name the same region or every request fails signing.
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-b2-key-id
S3_SECRET_ACCESS_KEY=your-b2-application-key
# Optional CDN origin. Defaults to <endpoint>/<bucket>.
S3_PUBLIC_URL=

# Client portal origin — used to build public album share links
NEXT_PUBLIC_PORTAL_URL=http://localhost:3002
